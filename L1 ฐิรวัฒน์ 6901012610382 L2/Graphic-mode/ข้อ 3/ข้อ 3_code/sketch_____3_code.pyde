def setup():
    size(500, 600)
    background(255)
    noFill()
    stroke(0)
    strokeWeight(2)
    

    line(250, 80, 80, 280)
    line(250, 80, 420, 280)
    line(80, 280, 420, 280)
    

    ellipse(250, 200, 100, 100)
    

    line(130, 280, 130, 380)
    line(370, 280, 370, 380)
    line(130, 380, 370, 380)
    

    line(170, 300, 270, 300)
    line(170, 360, 270, 360)
    line(170, 300, 170, 360)
    line(270, 300, 270, 360)
    line(220, 300, 220, 360)
    line(170, 330, 270, 330)
    

    line(130, 380, 130, 530)
    line(370, 380, 370, 530)
    line(130, 530, 370, 530)
    

    line(170, 420, 250, 420)
    line(170, 480, 250, 480)
    line(170, 420, 170, 480)
    line(250, 420, 250, 480)
    line(210, 420, 210, 480)
    line(170, 450, 250, 450)
    

    line(290, 420, 340, 420)
    line(290, 530, 340, 530)
    line(290, 420, 290, 530)
    line(340, 420, 340, 530)
    

    ellipse(300, 475, 8, 8)
